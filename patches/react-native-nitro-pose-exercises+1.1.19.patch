+// Kiest per hoek de kant (links of rechts) waarvan de drie punten het best zichtbaar zijn,
+// tenzij de configuratie beide kanten al afzonderlijk meet.
+private func bestTriple(_ a: Int, _ b: Int, _ c: Int, config: ExerciseConfig, threshold: Double) -> (Int, Int, Int)? {
+  let n = _landmarks.count
+  guard a < n, b < n, c < n else { return nil }
+  let own = min(_landmarks[a].visibility, _landmarks[b].visibility, _landmarks[c].visibility)
+
+  if let ma = Self.mirrorIndex[a], let mb = Self.mirrorIndex[b], let mc = Self.mirrorIndex[c],
+     ma < n, mb < n, mc < n {
+    let definedSeparately = config.angles.contains {
+      Int($0.landmarkA) == ma && Int($0.landmarkB) == mb && Int($0.landmarkC) == mc
+    }
+    if !definedSeparately {
+      let mirrored = min(_landmarks[ma].visibility, _landmarks[mb].visibility, _landmarks[mc].visibility)
+      if mirrored > own && mirrored > threshold { return (ma, mb, mc) }
+    }
+  }
+  return own > threshold ? (a, b, c) : nil
+}
