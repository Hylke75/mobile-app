+private fun bestTriple(a: Int, b: Int, c: Int, config: ExerciseConfig, threshold: Double): Triple<Int, Int, Int>? {
+  val n = _landmarks.size
+  if (a >= n || b >= n || c >= n) return null
+  val own = minOf(_landmarks[a].visibility, _landmarks[b].visibility, _landmarks[c].visibility)
+
+  val ma = mirrorIndex[a]; val mb = mirrorIndex[b]; val mc = mirrorIndex[c]
+  if (ma != null && mb != null && mc != null && ma < n && mb < n && mc < n) {
+    val definedSeparately = config.angles.any {
+      it.landmarkA.toInt() == ma && it.landmarkB.toInt() == mb && it.landmarkC.toInt() == mc
+    }
+    if (!definedSeparately) {
+      val mirrored = minOf(_landmarks[ma].visibility, _landmarks[mb].visibility, _landmarks[mc].visibility)
+      if (mirrored > own && mirrored > threshold) return Triple(ma, mb, mc)
+    }
+  }
+  return if (own > threshold) Triple(a, b, c) else null
