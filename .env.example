# Kopieer dit bestand naar .env en vul de waarden in (Supabase-dashboard → Project Settings → API).
# Alleen publieke sleutels; EXPO_PUBLIC_-variabelen worden in de app-bundel meegeleverd.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optioneel: crashrapporten via Sentry (sentry.io → Project → Client Keys). Leeg = uit.
# Kies bij het aanmaken de EU-regio (DSN eindigt op .de.sentry.io).
EXPO_PUBLIC_SENTRY_DSN=
